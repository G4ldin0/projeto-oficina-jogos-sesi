[sub_resource type="GDScript" id="GDScript_5rwky"]
resource_name = "sala_infinita"
script/source = "extends Sala

const CENA_DIABRETE: PackedScene = preload(\"res://elementos/entidade/inimigos/inimigo.tscn\")
const CENA_ESQUELETO: PackedScene = preload(\"res://elementos/entidade/inimigos/Esqueleto.tscn\")

@export var min_inimigos:int = 3
@export var max_inimigos:int = 6

func entrar_na_sala() -> void:
	if $Inimigos.get_children().size() > 0:
		for inimigo:Node2D in $Inimigos:
			inimigo.queue_free()

	var quantidade := randi_range(min_inimigos, max_inimigos)
	for indice in quantidade:
		var cena_inimigo := CENA_ESQUELETO if randi_range(0, 1) == 0 else CENA_DIABRETE
		var inimigo := cena_inimigo.instantiate() as Inimigo
		$Inimigos.add_child(inimigo)
		inimigo.position = Vector2(
			randf_range(-400.0, 400.0),
			randf_range(-180.0, 180.0)
		)

	super.entrar_na_sala()
"

