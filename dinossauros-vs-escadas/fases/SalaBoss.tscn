[sub_resource type="GDScript" id="GDScript_sala_boss"]
script/source = "extends Sala

func entrar_na_sala() -> void:
	super.entrar_na_sala()

	var boss := $Inimigos.get_node_or_null(\"EscadaBoss\") as EscadaBoss
	var interface_gameplay := get_tree().current_scene.find_child(\"InterfaceGameplay\", true, false)
	if is_instance_valid(boss) and is_instance_valid(interface_gameplay):
		interface_gameplay.mostrar_boss(boss, \"escada de mão\")
		AudioStreamPlayer2d.tocar_musica_boss()
	var gerenciador := get_tree().current_scene.find_child(\"GerenciadorDeMapa\", true, false) as GerenciadorDeMapa
	if is_instance_valid(gerenciador):
		gerenciador.definir_camera_acompanha_jogador(true)
"

